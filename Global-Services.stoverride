name: Global Services Check
desc: Tiles show only the unlocked region code (e.g. US, JP, SG); -- when not unlocked.
# All tiles are collapsed into Stash third-party services.
# Display is gated on the service being reachable; it does not guarantee account eligibility.
tiles: #!append
  - name: chatgpt-web-check
    title: ChatGPT Web
    icon: network
    collapsed: true
    interval: 600
    url: https://chatgpt.com
  - name: chatgpt-app-check
    title: ChatGPT App
    icon: network
    collapsed: true
    interval: 600
    url: https://chatgpt.com
  - name: gemini-check
    title: Gemini
    icon: network
    collapsed: true
    interval: 600
    url: https://gemini.google.com
  - name: grok-check
    title: Grok
    icon: network
    collapsed: true
    interval: 600
    url: https://grok.com
  - name: claude-check
    title: Claude
    icon: network
    collapsed: true
    interval: 600
    url: https://claude.ai
  - name: muse-check
    title: Muse
    icon: network
    collapsed: true
    interval: 600
    url: https://muse.ai
  - name: copilot-check
    title: Copilot
    icon: network
    collapsed: true
    interval: 600
    url: https://copilot.microsoft.com
  - name: perplexity-check
    title: Perplexity
    icon: network
    collapsed: true
    interval: 600
    url: https://www.perplexity.ai
  - name: deepseek-check
    title: DeepSeek
    icon: network
    collapsed: true
    interval: 600
    url: https://chat.deepseek.com
  - name: youtube-check
    title: YouTube
    icon: network
    collapsed: true
    interval: 600
    url: https://www.youtube.com
  - name: spotify-check
    title: Spotify
    icon: network
    collapsed: true
    interval: 600
    url: https://open.spotify.com
  - name: telegram-check
    title: Telegram
    icon: network
    collapsed: true
    interval: 600
    url: https://web.telegram.org
  - name: tiktok-check
    title: TikTok
    icon: network
    collapsed: true
    interval: 600
    url: https://www.tiktok.com
  - name: netflix-check
    title: Netflix
    icon: network
    collapsed: true
    interval: 600
    url: https://www.netflix.com

script-providers:
  chatgpt-web-check:
    url: https://fastly.jsdelivr.net/gh/U41ovo/stash-global-services@552d83d68bf50157b48115eea71d04fc0b818c7b/scripts/chatgpt-web-check.js
